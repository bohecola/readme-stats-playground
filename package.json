{
  "name": "readme-stats-playground",
  "private": true,
  "version": "0.1.0",
  "description": "Visual playground for github-readme-stats and GitHub Stats Extended cards: tweak parameters, preview live, copy Markdown/HTML.",
  "license": "MIT",
  "author": "bohecola",
  "homepage": "https://readme-stats.deore.me",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/bohecola/readme-stats-playground.git"
  },
  "bugs": {
    "url": "https://github.com/bohecola/readme-stats-playground/issues"
  },
  "keywords": [
    "github-readme-stats",
    "github-stats-extended",
    "readme",
    "github-profile",
    "playground",
    "react",
    "vite"
  ],
  "type": "module",
  "packageManager": "pnpm@11.7.0",
  "engines": {
    "node": ">=20.19"
  },
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "lint": "tsc --noEmit && tsc --noEmit -p tsconfig.node.json",
    "test": "vitest run"
  },
  "dependencies": {
    "class-variance-authority": "^0.7.1",
    "cn": "^0.4.0",
    "i18next": "^26.4.2",
    "i18next-browser-languagedetector": "^8.2.1",
    "lucide-react": "^0.468.0",
    "radix-ui": "^1.6.7",
    "react": "^19.3.0",
    "react-colorful": "^5.8.1",
    "react-dom": "^19.3.0",
    "react-i18next": "^17.0.15"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.3",
    "@types/node": "^22.10.1",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.1",
    "tailwindcss": "^4.3.3",
    "tw-animate-css": "^1.4.0",
    "typescript": "^5.6.3",
    "unplugin-auto-import": "^21.1.0",
    "vite": "^8.3.1",
    "vitest": "^5.0.1"
  }
}
