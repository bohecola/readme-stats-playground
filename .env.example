# Copy to .env.local (not committed) or set these in your hosting provider.

# github-readme-stats-compatible instance used until a visitor picks their own. Leave empty for a
# public playground (visitors get the GitHub Stats Extended public instance with one click, or enter
# their own); set it to yours when self-hosting for yourself. github-readme-stats' own public
# instance is unmaintained and currently paused.
VITE_DEFAULT_BASE_URL=

# Username pre-filled on first visit. Leave empty to start blank.
VITE_DEFAULT_USERNAME=

# Public URL of this deployment (no trailing slash), e.g. https://readme-stats-playground.vercel.app
# When set, the build adds the canonical link, og:url / og:image and JSON-LD for search engines and AI crawlers.
VITE_SITE_URL=
