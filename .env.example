# Copy to .env.local (not committed) or set these in your hosting provider.

# Your github-readme-stats instance. Defaults to the public instance.
# Self-hosting is recommended: the public one is shared and often rate-limited.
VITE_DEFAULT_BASE_URL=https://github-readme-stats.vercel.app

# Username pre-filled on first visit. Leave empty to start blank.
VITE_DEFAULT_USERNAME=
